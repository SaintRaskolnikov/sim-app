{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/cron/expire-sessions", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/" },
    { "source": "/register", "destination": "/" },
    { "source": "/monitor", "destination": "/" },
    { "source": "/control", "destination": "/" },
    { "source": "/ekg-library", "destination": "/" }
  ]
}
